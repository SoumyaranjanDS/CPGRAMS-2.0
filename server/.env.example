# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Provide MongoDB Atlas connection URI or local MongoDB URI
MONGODB_URI=mongodb://127.0.0.1:27017/cpgrams_redesign

# Redis Cache & Session Configuration (Optional, falls back to in-memory cache if offline)
REDIS_URL=redis://127.0.0.1:6379

# JWT Secrets for Stateless Authentication
JWT_SECRET=cpgrams_super_secret_jwt_access_key_2026_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cpgrams_super_secret_jwt_refresh_key_2026_production
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# AI Layer (OpenAI API key for Phase 3 Triage)
OPENAI_API_KEY=your_openai_api_key_here
